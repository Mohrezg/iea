        demand = customer_demands[cust_idx - 1]
        if np.all(route_quantities + demand <= vehicle_capacities[vehicle_index]):
            route.append(cust_idx)
            route_quantities += demand
        else:
            routes.append((route, vehicle_index, route_quantities.copy()))
            route = [cust_idx]
            route_quantities = demand.copy()
            vehicle_index = (vehicle_index + 1) % n_vehicles

    if route:
        routes.append((route, vehicle_index, route_quantities.copy()))

    for route, v_idx, quantities in routes:
        # Build route details string
        route_distance = dist_matrix[0][route[0]]
        details = f"Depot -> C{route[0]} ({route_distance:.3f} km)"
        for i in range(len(route) - 1):
            seg = dist_matrix[route[i]][route[i + 1]]
            route_distance += seg
            details += f" -> C{route[i + 1]} ({seg:.3f} km)"
        ret = dist_matrix[route[-1]][0]
        route_distance += ret
        details += f" -> Depot ({ret:.3f} km)"

        route_cost = route_distance * vehicles.iloc[v_idx]['Cost (RM per km)']
        total_distance += route_distance
        total_cost += route_cost

        # Build product quantity string
        prod_str = ", ".join([f"{p}: {q:.2f}" for p, q in zip(product_columns, quantities)])

        print(f"Vehicle {route_num} ({vehicles.index[v_idx]}):")
        print(f"  Round Trip Distance: {route_distance:.3f} km, Cost: RM {route_cost:.2f}")
        print(f"  Product quantities: {prod_str}")
        print(f"  Route: {details}\n")
        route_num += 1

    print(f"Total Distance = {total_distance:.3f} km")
    print(f"Total Cost = RM {total_cost:.2f}\n")

# --- Genetic Algorithm (time‑based termination + early stop) ---
def select(population, fitnesses, k=3):
    selected = []
    for _ in range(len(population)):
        tournament = random.sample(list(zip(population, fitnesses)), k)
        selected.append(min(tournament, key=lambda x: x[1])[0])
    return selected

def crossover(parent1, parent2):
    size = len(parent1)
    cxpoint1, cxpoint2 = sorted(random.sample(range(size), 2))
    child1 = [None] * size
    child2 = [None] * size
    child1[cxpoint1:cxpoint2] = parent1[cxpoint1:cxpoint2]
    child2[cxpoint1:cxpoint2] = parent2[cxpoint1:cxpoint2]
    fill_child(child1, parent2, cxpoint2, size)
    fill_child(child2, parent1, cxpoint2, size)
    return child1, child2

def fill_child(child, parent, start, size):
    pos = start
    for i in range(size):
        if parent[i] not in child:
            while child[pos] is not None:
                pos = (pos + 1) % size
            child[pos] = parent[i]

def mutate(solution, mutpb):
    for i in range(len(solution)):
        if random.random() < mutpb:
            j = random.randint(0, len(solution) - 1)
            solution[i], solution[j] = solution[j], solution[i]

def genetic_algorithm(customers, vehicles, population_size, generations, cxpb, mutpb, time_limit=None, patience_seconds=5.0):
    """
    Run GA. If time_limit (seconds) is given, stop after that time.
    If patience_seconds is given and no improvement for that duration, stop early.
    """
    print(f"\n🧬 Running Genetic Algorithm (pop={population_size}, cx={cxpb}, mut={mutpb})")
    if time_limit is not None:
        print(f"   Time limit = {time_limit:.1f} seconds")
    else:
        print(f"   Generations = {generations}")
    print(f"   Early‑stop patience = {patience_seconds:.1f} seconds")

    population = [create_initial_solution() for _ in range(population_size)]
    fitnesses = [evaluate(indv) for indv in population]
    best_solution = population[0]
    best_distance, best_cost = fitnesses[0]
    # find initial best
    for sol, (dist, cost) in zip(population, fitnesses):
        if cost < best_cost:
            best_solution, best_distance, best_cost = sol, dist, cost
    print(f"  Initial best: distance={best_distance:.2f} km, cost=RM {best_cost:.2f}")

    start_time = time.time()
    last_improvement_time = start_time   # track last time best improved
    gen = 0
    # Run until generation limit or time limit or patience expiry
    while gen < generations:
        # Check time limit
        if time_limit is not None and (time.time() - start_time) >= time_limit:
            break

        # Selection
        selected = select(population, fitnesses)
        next_population = []
        for i in range(0, len(selected), 2):
            if i + 1 < len(selected) and random.random() < cxpb:
                child1, child2 = crossover(selected[i], selected[i + 1])
            else:
                child1, child2 = selected[i], selected[i + 1] if i + 1 < len(selected) else selected[i]
            next_population.append(child1)
            next_population.append(child2)
        for indv in next_population:
            mutate(indv, mutpb)

        population = next_population
        fitnesses = [evaluate(indv) for indv in population]

        # Update best and record improvement time
        improved = False
        for sol, (dist, cost) in zip(population, fitnesses):
            if cost < best_cost:
                best_solution, best_distance, best_cost = sol, dist, cost
                last_improvement_time = time.time()   # update improvement timestamp
                improved = True

        gen += 1

        # Early stop check: no improvement for 'patience_seconds'
        if time.time() - last_improvement_time >= patience_seconds:
            print(f"  Early stopping: no improvement for {patience_seconds:.1f} seconds.")
            break

        # Print progress every 10 generations or at end
        if gen % 10 == 0 or gen == generations or (time_limit is not None and (time.time() - start_time) >= time_limit):
            elapsed = time.time() - start_time
            print(f"  Gen {gen:3d} (elapsed {elapsed:.1f}s): best distance={best_distance:.2f} km, cost=RM {best_cost:.2f}")

    # Return best found
    return best_solution, (best_distance, best_cost)

