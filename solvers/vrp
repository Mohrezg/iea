def print_table(title, rows, headers, col_width=12):
    """Print a formatted table with left-aligned headers and rows."""
    print(f"\n{title}")
    print("-" * (len(headers) * (col_width + 1) + 10))
    # Header
    header_line = f"{'':<{col_width}}"
    for h in headers:
        header_line += f"{h:<{col_width}}"
    print(header_line)
    # Separator
    print("-" * (len(headers) * (col_width + 1) + 10))
    # Rows
    for row_name, row_values in rows:
        line = f"{row_name:<{col_width}}"
        for v in row_values:
            if isinstance(v, float):
                line += f"{v:>{col_width}.2f}"
            else:
                line += f"{v:>{col_width}}"
        print(line)
    print("-" * (len(headers) * (col_width + 1) + 10))

