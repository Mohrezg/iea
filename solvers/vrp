                    print(f"    -> Total Distance: {distance:.3f} km, Total Cost: RM {cost:.2f}")
    return best_hyperparams, best_solution, best_distance, best_cost

# --- Variable Neighbourhood Search (time‑based + early stop) ---
def local_search(solution):
    best_solution = solution.copy()
    best_distance, best_cost = evaluate(best_solution)
    for i in range(len(solution)):
        for j in range(i + 1, len(solution)):
            new_solution = solution.copy()
            new_solution[i], new_solution[j] = new_solution[j], new_solution[i]
            new_distance, new_cost = evaluate(new_solution)
            if new_cost < best_cost:
                best_solution, best_distance, best_cost = new_solution, new_distance, new_cost
    return best_solution, best_distance, best_cost

def shake(solution, k):
    new_solution = solution.copy()
    for _ in range(k):
        i, j = random.sample(range(len(solution)), 2)
        new_solution[i], new_solution[j] = new_solution[j], new_solution[i]
    return new_solution

def variable_neighbourhood_search(customers, vehicles, max_iterations, k_max, time_limit=None, patience_seconds=5.0):
    """
    Run VNS. If time_limit (seconds) is given, stop after that time.
    If patience_seconds is given and no improvement for that duration, stop early.
    """
    print(f"\n🔄 Running VNS (k_max={k_max})")
    if time_limit is not None:
        print(f"   Time limit = {time_limit:.1f} seconds")
    else:
        print(f"   Max iterations = {max_iterations}")
    print(f"   Early‑stop patience = {patience_seconds:.1f} seconds")

    best_solution = create_initial_solution()
    best_distance, best_cost = evaluate(best_solution)
    print(f"  Initial best: distance={best_distance:.2f} km, cost=RM {best_cost:.2f}")

    start_time = time.time()
    last_improvement_time = start_time
    iteration = 0
    while iteration < max_iterations:
        # Check time limit
        if time_limit is not None and (time.time() - start_time) >= time_limit:
            break

        k = 1
        improved = False
        while k <= k_max:
            new_solution = shake(best_solution, k)
            new_solution, new_distance, new_cost = local_search(new_solution)
            if new_cost < best_cost:
                best_solution, best_distance, best_cost = new_solution, new_distance, new_cost
                last_improvement_time = time.time()   # update improvement timestamp
                elapsed = time.time() - start_time
                print(f"  Iter {iteration+1:3d}, k={k} (elapsed {elapsed:.1f}s): improved -> distance={best_distance:.2f} km, cost=RM {best_cost:.2f}")
                improved = True
                k = 1
            else:
                k += 1
        iteration += 1

        # Early stop check: no improvement for 'patience_seconds'
        if time.time() - last_improvement_time >= patience_seconds:
            print(f"  Early stopping: no improvement for {patience_seconds:.1f} seconds.")
            break

        # Print progress every 5 iterations or at time limit
        if iteration % 5 == 0 or (time_limit is not None and (time.time() - start_time) >= time_limit):
            elapsed = time.time() - start_time
            print(f"  Iter {iteration:3d} (elapsed {elapsed:.1f}s): best distance={best_distance:.2f} km, cost=RM {best_cost:.2f}")

    return best_solution, best_distance, best_cost

# --- Hyperparameter tuning for VNS (iteration‑based) ---
max_iterations_list = [50, 100, 150]
k_max_list = [3, 5, 7]

def hyperparameter_tuning_vns(customers, vehicles, max_iterations_list, k_max_list):
