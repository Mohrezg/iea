# Functions used by both Algorithms (modified for product capacities)
# ----------------------------------------------------------------------
def create_initial_solution():
    """Return a random permutation of customer indices (1‑based)."""
    return random.sample(range(1, n_customers + 1), n_customers)

def evaluate(solution):
    """
    Evaluate a solution (permutation of customer indices).
    Returns (total_distance, total_cost) respecting product capacities.
    """
    total_distance = 0
    total_cost = 0
    route = []                  # list of customer indices in current route
    route_quantities = np.zeros(n_products)   # accumulated product quantities
    vehicle_index = 0

    # We'll store each complete route as (route_list, vehicle_idx, quantities_vector)
    routes = []

    for cust_idx in solution:
        # customer index is 1‑based, convert to 0‑based for array access
        demand = customer_demands[cust_idx - 1]
        # Check if we can add this customer to the current vehicle
        if np.all(route_quantities + demand <= vehicle_capacities[vehicle_index]):
            route.append(cust_idx)
            route_quantities += demand
        else:
            # Close current route and start a new one with the next vehicle
            routes.append((route, vehicle_index, route_quantities.copy()))
            route = [cust_idx]
            route_quantities = demand.copy()
            vehicle_index = (vehicle_index + 1) % n_vehicles

    if route:
        routes.append((route, vehicle_index, route_quantities.copy()))

    # Compute distance and cost for each route
    for route, v_idx, quantities in routes:
        # Distance from depot to first customer
        route_distance = dist_matrix[0][route[0]]
        # Between customers
        for i in range(len(route) - 1):
            route_distance += dist_matrix[route[i]][route[i + 1]]
        # Return to depot
        route_distance += dist_matrix[route[-1]][0]

        total_distance += route_distance
        total_cost += route_distance * vehicles.iloc[v_idx]['Cost (RM per km)']

    return total_distance, total_cost

def print_solution(best_solution, customers, vehicles, dist_matrix):
